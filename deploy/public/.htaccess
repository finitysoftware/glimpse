Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 default

RewriteEngine On

# Every API path, including a missing one, is handled by Slim as JSON.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

# Block private paths even if an operator accidentally places an extra directory here.
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^(?:private|backend|vendor|config|src|bin|migrations|tests|docs|artifacts|website)(?:/|$) - [R=404,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|[^/]*\.md|LICENSE)$ - [R=404,L,NC]
RewriteRule \.php$ - [R=404,L,NC]

# Existing static files: the landing page (index.html at /), its assets and the compiled workspace assets.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Only sign-in, the workspace, the admin panel and visitor links use the React entry.
RewriteRule ^(?:login/?|app(?:/.*)?|admin(?:/.*)?|s/[^/]+(?:/.*)?)$ workspace.html [L]

# Anything else, including missing assets, is not found; the empty path falls through to the landing page.
RewriteRule ^. - [R=404,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # Only the landing page and the icons and preview image it references may appear in search results.
    <FilesMatch "^(?!(?:index\.html|favicon\.svg|apple-touch-icon\.png|og-image\.png)$)">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    <FilesMatch "^(?:index|workspace)\.html$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
