Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 403 default

RewriteEngine On

# This directory is the subdomain document root, containing public/ and private/.
RewriteRule ^private(?:/|$) - [F,L,NC]
# Other hidden paths are handled in public/ so every /api route reaches Slim.
RewriteRule ^\. - [F,L]

# Keep internal rewrites from adding another public/ prefix.
# Use L, not END: public/.htaccess must still process API and SPA routes.
RewriteRule ^public(?:/|$) - [L]

# Relative targets work when git/ is the subdomain document root.
RewriteRule ^$ public/index.html [L]
RewriteRule ^(.*)$ public/$1 [L]
